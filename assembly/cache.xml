<assembly
    xmlns="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.3"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.3 http://maven.apache.org/xsd/assembly-1.1.3.xsd">
    <id>cache</id>
    <includeBaseDirectory>false</includeBaseDirectory>
    <formats>
        <format>tar.gz</format>
    </formats>
    <fileSets>
        <fileSet>
            <directory></directory>
            <outputDirectory></outputDirectory>
            <includes>
                <include>bin/*</include>
                <include>bin/*.js</include>
                <include>bin/**/*</include>
                <include>bin/**/*.js</include>
                <include>lib/**/bin/*</include>
                <include>lib/**/bin/*.js</include>
                <include>lib/**/bin/**/*</include>
                <include>lib/**/bin/**/*.js</include>
                <include>node/node</include>
                <include>node/npm</include>
                <include>node/*.js</include>
                <include>node/**/*.js</include>
                <include>node/**/bin/**/*</include>
                <include>node_modules/*.js</include>
                <include>node_modules/**/*.js</include>
                <include>node_modules/**/bin/*</include>
                <include>node_modules/**/bin/**/*</include>
                <include>node_modules/**/chromedriver</include>
                <include>node_modules/**/geckodriver</include>
            </includes>
            <fileMode>0755</fileMode>
            <lineEnding>keep</lineEnding>
        </fileSet>
        <fileSet>
            <directory></directory>
            <outputDirectory></outputDirectory>
            <includes>
                <include>bin/**/*</include>
                <include>etc/**/*</include>
                <include>lib/**/*</include>
                <include>node/**/*</include>
                <include>node_modules/**/*</include>
                <include>share/**/*</include>
            </includes>
            <lineEnding>keep</lineEnding>
        </fileSet>
    </fileSets>
</assembly>
