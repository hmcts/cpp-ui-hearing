{
  "name": "cpp.ui.hearing",
  "version": "0.0.1-SNAPSHOT",
  "license": "MIT",
  "description": "Hearing application",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --verbose",
    "build:prod": "ng build --configuration production",
    "lint": "ng lint",
    "ci:lint": "mkdirp ./build/lint && ng run cpp-ui-hearing:ci-lint 1> ./build/lint/tslint-checkstyle-result.xml",
    "test": "ng test",
    "test:watch": "ng test --watch",
    "ci:test": "ng run cpp-ui-hearing:ci-test",
    "nsp": "exit 0",
    "ci:nsp": "exit 0",
    "sonar:scanner": "sonar-scanner -Dproject.settings=./sonar-project.properties -Dsonar.projectVersion=${version} -Dsonar.host.url=https://sonarqube-internal.mdv.cpp.nonlive -Dsonar.branch=team/CC",
    "code:format": "pretty-quick --staged"
  },
  "husky": {
    "hooks": {
      "pre-commit": "run-s code:format lint"
    }
  },
  "jest-junit": {
    "output": "build/test/test-results.xml"
  },
  "private": true,
  "dependencies": {
