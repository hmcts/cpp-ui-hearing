                              id="pdk-autosuggest__suggestions-container-GENERATED_ID"
                            >
                            </div>
                          </div>
                        </div>
                      </pdk-interaction-container>
                    </pdk-autosuggest>
                  </pdk-autosuggest-lite>
                </pdk-form-group>
              </pdk-form-field>
            </div>
            <button
              class="save-trial-type-btn govuk-!-margin-top-3 govuk-button"
              data-role="save-trial-type-btn"
              disabled="disabled"
              pdk-button=""
              pdk-margin-top="3"
              type="button"
            >
               COMMON.SAVE 
            </button>
          </form>
        </pdk-details-text>
      </details>
    </section>
  </trial-type>
</ng-component>
`;
