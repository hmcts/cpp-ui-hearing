exports[`FixedListInputComponent FIXLO prompt choice should populate an "Other" entry 1`] = `
<ng-component
  limit={[Function Number]}
  onChange={[Function Function]}
  promptChoice={[Function Object]}
  value={[Function String]}
>
  <cpp-fixed-list-input
    class="ng-untouched ng-pristine ng-valid"
  >
    <pdk-select
      class="ng-untouched ng-pristine ng-valid"
      justified=""
    >
      <select
        class="govuk-select pdk-select--justified"
        id="pdk-select-GENERATED_ID"
      >
        <option
          value="0"
        >
          This is for a case management hearing. You must attend this hearing
        </option>
        <option
          value="1"
        >
          This is for a case management hearing. You need not attend this hearing and a new trial date will be sent to you. If you do not get a new date sent to you within 5 days of this hearing, you must contact the court
        </option>
        <option
          value="2"
        >
          This is for the trial to take place, where the court will hear the evidence in the case. You must attend this hearing
        </option>
        <option
          value="3"
        >
          Other
        </option>
      </select>
    </pdk-select>
    <div
      class="govuk-!-margin-top-2 pdk-!-border-color-mid-grey govuk-!-padding-left-3 govuk-!-padding-top-3"
      pdk-border-colour="mid-grey"
      pdk-margin-top="2"
      pdk-padding-left="3"
      pdk-padding-top="3"
      style="border-left: 4px solid;"
    >
      <pdk-form-field
        label="Enter description"
        labeltype="small"
      >
        <pdk-form-group
          class="pdk-form-group"
        >
          <label
            class="govuk-label govuk-label--s"
            for="pdk-form-control-undefined-GENERATED_ID"
          >
             Enter description 
          </label>
          <input
            class="ng-untouched ng-pristine ng-invalid govuk-input"
            id="pdk-form-control-undefined-GENERATED_ID"
            pdk-input=""
            pdk-text-input=""
            required=""
            type="text"
          />
        </pdk-form-group>
      </pdk-form-field>
    </div>
  </cpp-fixed-list-input>
</ng-component>
`;

