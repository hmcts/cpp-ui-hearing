                                            id="cpp-result-prompts-form-duration-input-GENERATED_IDWeeks"
                                            maxlength="4"
                                            pattern="^(?:[1-9][0-9]*)"
                                            pdk-margin-right="2"
                                            type="text"
                                          />
                                        </div>
                                        <div
                                          style="display: inline-block;"
                                        >
                                          <label
                                            class="govuk-label"
                                            for="cpp-result-prompts-form-duration-input-GENERATED_IDDays"
