        <div
          data-test-id="totalCustodialPeriod"
        >
          <cpp-oneof-prompt-choice>
            <pdk-form-field
              labeltype="small"
            >
              <pdk-form-group
                class="pdk-form-group"
              >
                <fieldset
                  class="govuk-fieldset"
                  pdk-fieldset=""
                >
                  <legend
                    class="govuk-fieldset__legend govuk-fieldset__legend--s"
                  >
                     Total custodial period 
                  </legend>
                  <pdk-radio-group
                    class="ng-untouched ng-pristine ng-valid"
                    required=""
                  >
                    <div
                      class="govuk-radios"
                    >
                      <pdk-radio-button>
                        <div
                          class="govuk-radios__item"
                        >
                          <input
                            class="govuk-radios__input"
                            id="pdk-radio-GENERATED_ID"
                            name="pdk-radio-group-GENERATED_ID"
                            type="radio"
                            value="0"
                          />
                          <label
                            class="govuk-radios__label govuk-label"
                            for="pdk-radio-GENERATED_ID"
                            pdk-label=""
                          >
                            Total custodial period is life
                          </label>
                        </div>
                      </pdk-radio-button>
                      <pdk-radio-button>
                        <div
                          class="govuk-radios__item"
                        >
                          <input
                            class="govuk-radios__input"
                            id="pdk-radio-GENERATED_ID"
                            name="pdk-radio-group-GENERATED_ID"
                            type="radio"
                            value="1"
                          />
                          <label
                            class="govuk-radios__label govuk-label"
                            for="pdk-radio-GENERATED_ID"
                            pdk-label=""
                          >
                            Total custodial period
                          </label>
                        </div>
                      </pdk-radio-button>
                      <pdk-radio-conditional>
                        <div
                          class="govuk-radios__conditional"
                        >
                          <cpp-prompt-choice>
                            <div
                              data-test-id="totalCustodialPeriod"
                            >
                              <cpp-duration-prompt-choice>
                                <pdk-form-field
                                  labeltype="small"
                                >
                                  <pdk-form-group
                                    class="pdk-form-group"
                                  >
                                    <fieldset
                                      class="govuk-fieldset"
                                      pdk-fieldset=""
                                    >
                                      <legend
                                        class="govuk-fieldset__legend govuk-fieldset__legend--s"
                                      >
                                         Total custodial period 
                                      </legend>
                                      <pdk-hint
                                        class="govuk-hint"
                                      >
                                        <div>
                                           Only use one duration unit 
                                        </div>
                                      </pdk-hint>
                                      <cpp-duration-input
                                        class="ng-untouched ng-pristine ng-valid"
                                      >
                                        <div
                                          style="display: inline-block;"
                                        >
                                          <label
                                            class="govuk-label"
                                            for="cpp-result-prompts-form-duration-input-GENERATED_IDYears"
                                            pdk-label=""
                                          >
                                            Years
                                          </label>
                                          <input
                                            autocomplete="off"
                                            class="govuk-!-margin-right-2 ng-untouched ng-pristine ng-valid govuk-input govuk-input--width-3"
                                            id="cpp-result-prompts-form-duration-input-GENERATED_IDYears"
                                            maxlength="4"
                                            pattern="^(?:[1-9][0-9]*)"
                                            pdk-margin-right="2"
                                            type="text"
                                          />
                                        </div>
                                        <div
                                          style="display: inline-block;"
                                        >
                                          <label
                                            class="govuk-label"
                                            for="cpp-result-prompts-form-duration-input-GENERATED_IDMonths"
                                            pdk-label=""
                                          >
                                            Months
                                          </label>
                                          <input
                                            autocomplete="off"
                                            class="govuk-!-margin-right-2 ng-untouched ng-pristine ng-valid govuk-input govuk-input--width-3"
                                            id="cpp-result-prompts-form-duration-input-GENERATED_IDMonths"
                                            maxlength="4"
                                            pattern="^(?:[1-9][0-9]*)"
                                            pdk-margin-right="2"
                                            type="text"
                                          />
                                        </div>
                                        <div
                                          style="display: inline-block;"
                                        >
                                          <label
                                            class="govuk-label"
                                            for="cpp-result-prompts-form-duration-input-GENERATED_IDWeeks"
                                            pdk-label=""
                                          >
                                            Weeks
                                          </label>
                                          <input
                                            autocomplete="off"
