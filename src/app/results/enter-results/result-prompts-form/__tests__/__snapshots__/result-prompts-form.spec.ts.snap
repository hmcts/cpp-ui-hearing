                          formcontrolname="minutes"
                          id="pdk-time-input-GENERATED_ID-minutes"
                          maxlength="2"
                          minlength="2"
                          name="timeMinutes"
                          pattern="[0-9]*"
                          type="text"
                        />
                      </div>
                    </div>
                  </pdk-time-input>
                </fieldset>
              </pdk-form-group>
            </pdk-form-field>
