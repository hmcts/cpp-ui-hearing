exports[`ResultPromptsForm CURR prompt should render a currency input 1`] = `
<ng-component
  handleErrors={[Function Function]}
  handleFormSubmit={[Function Function]}
  promptChoices={[Function Array]}
>
  <cpp-result-prompts-form>
    <form
      class="ng-untouched ng-pristine ng-valid"
      errorformat="extended"
      novalidate=""
      pdk-form=""
    >
      <cpp-prompt-choice>
        <div
          data-test-id="IAMT"
        >
          <cpp-curr-prompt-choice>
            <pdk-form-field
              labeltype="small"
            >
              <pdk-form-group
                class="pdk-form-group"
              >
                <label
                  class="govuk-label govuk-label--s"
                  for="pdk-currency-input-GENERATED_ID"
                >
                   Instalment amount 
                </label>
                <pdk-currency-input
                  class="ng-untouched ng-pristine ng-valid"
                >
                  <div
                    class="pdk-currency-input"
                  >
                    <input
                      autocomplete="off"
                      class="ng-untouched ng-pristine ng-valid govuk-input govuk-input--width-10"
                      id="pdk-currency-input-GENERATED_ID"
                      name="IAMT"
                      pattern="/^$|(?=.*?\\d)^\\$?(([1-9]\\d{0,2}(,\\d{3})*)|\\d+)?(\\.\\d{2})?$/"
                      type="text"
                    />
                  </div>
                </pdk-currency-input>
              </pdk-form-group>
            </pdk-form-field>
          </cpp-curr-prompt-choice>
        </div>
      </cpp-prompt-choice>
      <pdk-button-group>
        <div
          class="govuk-button-group"
        >
          <button
            class="govuk-button"
            pdk-button=""
            type="submit"
          >
            Save result details
          </button>
        </div>
      </pdk-button-group>
    </form>
  </cpp-result-prompts-form>
</ng-component>
`;

