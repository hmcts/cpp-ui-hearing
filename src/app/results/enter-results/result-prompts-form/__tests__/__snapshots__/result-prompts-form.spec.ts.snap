exports[`ResultPromptsForm NAMEADDRESS prompt Organisation should prepopulate the input using an organisation result prompt 1`] = `
<ng-component
  handleErrors={[Function Function]}
  handleFormSubmit={[Function Function]}
  promptChoices={[Function Array]}
  resultPrompts={[Function Array]}
>
  <cpp-result-prompts-form>
    <form
      class="ng-untouched ng-pristine ng-valid"
      errorformat="extended"
      novalidate=""
      pdk-form=""
    >
      <cpp-prompt-choice>
        <div
          data-test-id="prison"
        >
          <cpp-nameaddress-prompt-choice>
            <pdk-form-field
              hinttext="Please start typing the name"
              labeltype="small"
            >
              <pdk-form-group
                class="pdk-form-group"
              >
                <label
                  class="govuk-label govuk-label--s"
                  for="pdk-form-control-undefined-GENERATED_ID"
                >
                   Select Prison 
                </label>
                <pdk-hint
                  class="govuk-hint"
                >
                  <div>
                     Please start typing the name 
                  </div>
                </pdk-hint>
                <pdk-autosuggest-lite
                  class="ng-untouched ng-pristine ng-valid"
                  suggestionkey="label"
                  suggestiontitle="label"
                >
                  <pdk-autosuggest
                    highlightcolor="blue"
                  >
                    <pdk-interaction-container>
                      <div>
                        <div
                          class="pdk-autosuggest"
                        >
                          <input
                            aria-autocomplete="list"
                            aria-controls="pdk-autosuggest__suggestions-container-GENERATED_ID-listbox"
                            aria-describedby="pdk-autosuggest__instructions-GENERATED_ID"
                            aria-expanded="false"
                            autocomplete="off"
                            class="pdk-autosuggest__input ng-untouched ng-pristine ng-valid govuk-input"
                            id="pdk-form-control-undefined-GENERATED_ID"
                            role="combobox"
                            type="text"
                          />
                          <span
                            class="govuk-visually-hidden"
                            id="pdk-autosuggest__instructions-GENERATED_ID"
                            pdk-visually-hidden=""
                          >
                             When autocomplete results are available, use the up and down arrows to review and Enter to select. Touch device users, explore options with swipe gestures. 
                          </span>
                          <span
                            aria-live="polite"
                            class="govuk-visually-hidden"
                            pdk-visually-hidden=""
                            role="status"
                          >
                          </span>
                          <div
                            class="pdk-autosuggest__suggestions-container"
                            id="pdk-autosuggest__suggestions-container-GENERATED_ID"
                          >
                          </div>
                        </div>
                      </div>
                    </pdk-interaction-container>
