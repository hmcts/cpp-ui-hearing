                >
                   . 
                </span>
                <span
                  data-test-id="offenceTitle"
                >
                  Offence title
                </span>
              </h5>
              <div
                class="pdk-!-negative-margin-top-4 govuk-!-margin-bottom-4 govuk-body-m"
                pdk-margin-bottom="4"
                pdk-margin-top="-4"
                pdk-typography="body"
              >
                <pdk-foldable-text
                  class="pdk-!-text-color-dark-grey"
                  data-test-id="offenceWording"
                  pdk-text-colour="dark-grey"
                >
