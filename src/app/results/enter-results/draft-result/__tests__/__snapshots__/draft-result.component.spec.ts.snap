              </div>
              <cpp-draft-result-parser>
                <form
                  class="ng-untouched ng-pristine ng-valid"
                  novalidate=""
                  pdk-form=""
                >
                  <pdk-form-field
                    labeltype="none"
                  >
                    <pdk-form-group
                      class="pdk-form-group"
                    >
                      <label
                        class="govuk-visually-hidden govuk-label"
                        for="pdk-form-control-undefined-GENERATED_ID"
                      >
                         Enter result for Offence title 
                      </label>
                      <textarea
                        class="ng-untouched ng-pristine ng-valid govuk-input"
                        id="pdk-form-control-undefined-GENERATED_ID"
                        name="rawText"
                        ngmodel=""
                        pdk-resize=""
                        pdk-text-input=""
                        style="resize: none; min-height: NaNpx; max-height: NaNpx;"
                      >
                      </textarea>
                    </pdk-form-group>
                  </pdk-form-field>
                </form>
              </cpp-draft-result-parser>
              <pdk-checkbox
                checkboxtype="small"
                class="pdk-!-negative-margin-top-4 govuk-checkboxes govuk-checkboxes--small ng-untouched ng-pristine ng-valid"
                data-test-id="toggleShadowListing"
                pdk-margin-top="-4"
              >
                <div
                  class="govuk-checkboxes__item"
                >
                  <input
                    class="govuk-checkboxes__input"
                    id="pdk-checkbox-GENERATED_ID"
                    type="checkbox"
                    value="true"
                  />
                  <label
                    class="govuk-label govuk-checkboxes__label"
                    for="pdk-checkbox-GENERATED_ID"
                  >
                     Exclude 
                    <span
                      class="govuk-visually-hidden"
                      pdk-visually-hidden=""
                    >
                      Offence title
                    </span>
                     offence from list (next hearing) 
                  </label>
                </div>
              </pdk-checkbox>
            </cpp-draft-result-offence>
          </li>
        </ul>
      </div>
    </cpp-draft-result-body>
  </cpp-draft-result>
</ng-component>
`;

