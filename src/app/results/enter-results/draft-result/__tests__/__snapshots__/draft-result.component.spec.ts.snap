        pdk-margin-vertical="6"
      >
        <h3
          class="govuk-heading-m"
          pdk-typography="heading-medium"
        >
        </h3>
        <h4
          class="govuk-visually-hidden"
          pdk-visually-hidden=""
        >
          Applications
        </h4>
        <ul
          class="govuk-list"
          pdk-list=""
        >
          <li
            class="govuk-!-margin-top-6 govuk-!-margin-bottom-6 govuk-body-s"
            data-test-id="application"
            pdk-margin-vertical="6"
            pdk-typography="body-small"
          >
            <cpp-draft-result-application>
              <dl
                class="govuk-body-m"
                pdk-typography="body"
              >
                <div
                  class="govuk-!-margin-bottom-3"
                  pdk-margin-bottom="3"
                >
                  <dt
                    class="pdk-!-text-color-dark-grey"
                    pdk-text-colour="dark-grey"
                  >
                    Application reference
                  </dt>
                  <dd>
                    APPLICATION_URN
                  </dd>
                </div>
                <div
                  class="govuk-!-margin-bottom-3"
                  pdk-margin-bottom="3"
                >
                  <dt
                    class="pdk-!-text-color-dark-grey"
                    pdk-text-colour="dark-grey"
                  >
                    Application particulars
                  </dt>
                  <dd>
                    Application particulars text
                  </dd>
                </div>
                <div>
                  <dt
                    class="govuk-visually-hidden"
                    pdk-visually-hidden=""
                  >
                    Application type
                  </dt>
                  <dd
                    data-test-id="application-type"
                  >
                    Application type
                  </dd>
                </div>
                <div>
                  <dt
                    class="govuk-visually-hidden"
                    pdk-visually-hidden=""
                  >
                    Application legislation
                  </dt>
                  <dd
                    style="font-weight: normal;"
                  >
                    <pdk-foldable-text
                      class="pdk-!-text-color-dark-grey"
                      pdk-text-colour="dark-grey"
                    >
                    </pdk-foldable-text>
                  </dd>
                </div>
              </dl>
              <cpp-draft-result-parser>
                <form
                  class="ng-untouched ng-pristine ng-valid"
                  novalidate=""
                  pdk-form=""
                >
                  <pdk-form-field
                    labeltype="none"
                  >
                    <pdk-form-group
                      class="pdk-form-group"
                    >
                      <label
                        class="govuk-visually-hidden govuk-label"
                        for="pdk-form-control-undefined-GENERATED_ID"
                      >
                         Enter result for Application type 
                      </label>
                      <textarea
                        class="ng-untouched ng-pristine ng-valid govuk-input"
                        id="pdk-form-control-undefined-GENERATED_ID"
                        name="rawText"
                        ngmodel=""
                        pdk-resize=""
                        pdk-text-input=""
                        style="resize: none; min-height: NaNpx; max-height: NaNpx;"
                      >
                      </textarea>
                    </pdk-form-group>
                  </pdk-form-field>
                </form>
              </cpp-draft-result-parser>
            </cpp-draft-result-application>
          </li>
        </ul>
      </div>
    </cpp-draft-result-body>
  </cpp-draft-result>
</ng-component>
`;

