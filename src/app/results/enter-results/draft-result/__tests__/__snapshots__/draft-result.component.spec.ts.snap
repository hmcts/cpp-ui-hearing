                  </pdk-form-field>
                </form>
              </cpp-draft-result-parser>
            </cpp-draft-result-application>
          </li>
          <li
            class="govuk-!-margin-top-6 govuk-!-margin-bottom-6 govuk-body-s"
            data-test-id="offence"
            pdk-margin-vertical="6"
            pdk-typography="body-small"
          >
            <cpp-draft-result-offence>
              <h5
                class="govuk-heading-s"
                pdk-typography="heading-small"
              >
                <span
                  class="offence-index govuk-!-margin-right-2"
                  pdk-margin-right="2"
                >
                   . 
                </span>
                <span
                  data-test-id="offenceTitle"
                >
                  Offence title
                </span>
              </h5>
              <div
                class="pdk-!-negative-margin-top-4 govuk-!-margin-bottom-4 govuk-body-m"
                pdk-margin-bottom="4"
                pdk-margin-top="-4"
                pdk-typography="body"
              >
                <pdk-foldable-text
                  class="pdk-!-text-color-dark-grey"
                  data-test-id="offenceWording"
                  pdk-text-colour="dark-grey"
                >
                   Offence wording 
