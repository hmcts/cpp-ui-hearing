  <cpp-draft-result-line-container>
    <cpp-draft-result-line>
      <div>
        <cpp-resolved-draft-result-line>
          <div
            class="result-line-header"
          >
            <div
              class="govuk-!-margin-right-1"
              cpp-draft-result-line-tag=""
              data-test-id="resultLineTitle"
              pdk-margin-right="1"
            >
              <div
                class="govuk-!-padding-left-1 govuk-!-padding-right-1 govuk-!-margin-0 govuk-body-s"
                pdk-margin="0"
                pdk-padding-horizontal="1"
                pdk-typography="body-small"
                style="display: inline-block; background-color: #d5d7ed;"
              >
                <h6
                  class="govuk-!-margin-0 govuk-body-s"
                  pdk-margin="0"
                  pdk-typography="body-small"
                >
                  <b>
                    Bail conditions
                  </b>
                </h6>
              </div>
            </div>
            <cpp-draft-result-line-options>
            </cpp-draft-result-line-options>
          </div>
          <cpp-child-result-definitions-form
            class="govuk-!-margin-top-3"
            pdk-margin-top="3"
            style="display: block;"
          >
            <form
              class="ng-untouched ng-pristine ng-valid"
              novalidate=""
              pdk-form=""
            >
              <pdk-form-field
                label="Additional result(s) required, please select one OR more"
                labeltype="small"
              >
                <pdk-form-group
                  class="pdk-form-group"
                >
                  <label
                    class="govuk-label govuk-label--s"
                    for="pdk-form-control-undefined-GENERATED_ID"
                  >
                     Additional result(s) required, please select one OR more 
                  </label>
                  <pdk-autosuggest-lite
                    class="ng-untouched ng-pristine ng-valid"
                    name="atLeastOneOf"
                    ngmodel=""
                    suggestionkey="code"
                    suggestiontitle="label"
                  >
                    <pdk-autosuggest
                      highlightcolor="blue"
                    >
                      <pdk-interaction-container>
                        <div>
                          <div
                            class="pdk-autosuggest"
                          >
                            <input
                              aria-autocomplete="list"
                              aria-controls="pdk-autosuggest__suggestions-container-GENERATED_ID-listbox"
                              aria-describedby="pdk-autosuggest__instructions-GENERATED_ID"
                              aria-expanded="false"
                              autocomplete="off"
                              class="pdk-autosuggest__input ng-untouched ng-pristine ng-valid govuk-input"
                              id="pdk-form-control-undefined-GENERATED_ID"
                              role="combobox"
                              type="text"
                            />
                            <span
                              class="govuk-visually-hidden"
                              id="pdk-autosuggest__instructions-GENERATED_ID"
                              pdk-visually-hidden=""
                            >
                               When autocomplete results are available, use the up and down arrows to review and Enter to select. Touch device users, explore options with swipe gestures. 
                            </span>
                            <span
                              aria-live="polite"
                              class="govuk-visually-hidden"
                              pdk-visually-hidden=""
                              role="status"
                            >
                            </span>
                            <div
                              class="pdk-autosuggest__suggestions-container"
                              id="pdk-autosuggest__suggestions-container-GENERATED_ID"
                            >
                            </div>
                          </div>
                        </div>
                      </pdk-interaction-container>
                    </pdk-autosuggest>
                  </pdk-autosuggest-lite>
                </pdk-form-group>
              </pdk-form-field>
            </form>
          </cpp-child-result-definitions-form>
        </cpp-resolved-draft-result-line>
      </div>
    </cpp-draft-result-line>
  </cpp-draft-result-line-container>
</ng-component>
`;

