exports[`DraftResultLineContainer resolved result line NHCCS definition should render the result prompts form for a related hearing 1`] = `
<ng-component
  onErrors={[Function Function]}
  resultLineId={[Function String]}
  ruleType={[Function String]}
>
  <cpp-draft-result-line-container>
    <cpp-draft-result-line>
      <div>
        <cpp-resolved-draft-result-line>
          <div
            class="result-line-header"
          >
            <div
              class="govuk-!-margin-right-1"
              cpp-draft-result-line-tag=""
              data-test-id="resultLineTitle"
              pdk-margin-right="1"
            >
              <div
                class="govuk-!-padding-left-1 govuk-!-padding-right-1 govuk-!-margin-0 govuk-body-s"
                pdk-margin="0"
                pdk-padding-horizontal="1"
                pdk-typography="body-small"
                style="display: inline-block; background-color: #d5d7ed;"
              >
                <h6
                  class="govuk-!-margin-0 govuk-body-s"
                  pdk-margin="0"
                  pdk-typography="body-small"
                >
                  <b>
                    Next hearing in Crown Court
                  </b>
                </h6>
              </div>
            </div>
            <cpp-draft-result-line-options>
              <pdk-link-group>
                <a
                  class="govuk-link"
                  data-test-id="change-result-line"
                  href="javascript:void(0)"
                  pdk-link=""
                >
                  Change
                  <span
                    class="govuk-visually-hidden"
                    pdk-visually-hidden=""
                  >
                     Next hearing in Crown Court
                  </span>
                </a>
                <a
                  class="govuk-link"
                  data-test-id="delete-result-line"
                  href="javascript:void(0)"
                  pdk-link=""
                >
                  Delete
                  <span
                    class="govuk-visually-hidden"
                    pdk-visually-hidden=""
                  >
                     Next hearing in Crown Court
                  </span>
                </a>
              </pdk-link-group>
            </cpp-draft-result-line-options>
          </div>
          <cpp-result-prompts-summary
            style="display: block;"
          >
            <dl
              class="result-prompts-summary result-prompts-summary--inline"
            >
            </dl>
          </cpp-result-prompts-summary>
          <cpp-draft-result-line-body>
            <div
              class="govuk-!-margin-top-2 govuk-!-margin-bottom-6"
              pdk-margin-bottom="6"
              pdk-margin-top="2"
              style="max-width: 680px;"
            >
              <cpp-nhccs-result-line-body>
                <details
                  class="govuk-details"
                  open=""
                  pdk-details=""
                >
                  <summary
                    class="govuk-details__summary"
                    pdk-summary=""
                  >
                    <span
                      class="govuk-details__summary-text"
                    >
                      Result details
                    </span>
                  </summary>
                  <pdk-details-text
                    class="govuk-details__text"
                  >
                    <cpp-result-prompts-form>
                      <form
                        class="ng-untouched ng-dirty ng-invalid"
                        errorformat="extended"
                        novalidate=""
                        pdk-form=""
                      >
                        <cpp-prompt-choice>
                          <div
                            data-test-id="remandStatus"
                          >
                            <cpp-fixl-prompt-choice>
                              <pdk-form-field
                                labeltype="small"
                              >
                                <pdk-form-group
                                  class="pdk-form-group"
                                >
                                  <fieldset
                                    class="govuk-fieldset"
                                    pdk-fieldset=""
                                  >
                                    <legend
                                      class="govuk-fieldset__legend govuk-fieldset__legend--s"
                                    >
                                       Remand Status 
                                    </legend>
                                    <cpp-fixed-list-input
                                      class="ng-untouched ng-pristine ng-invalid"
                                    >
                                      <pdk-select
                                        class="ng-untouched ng-pristine ng-valid"
                                        justified=""
                                      >
                                        <select
                                          aria-label="Remand Status"
                                          class="govuk-select pdk-select--justified"
                                          id="pdk-select-GENERATED_ID"
                                        >
                                          <option
                                            value="0"
                                          >
                                            Conditional Bail
                                          </option>
                                          <option
                                            value="1"
                                          >
                                            Defendant not Present
                                          </option>
                                          <option
                                            value="2"
                                          >
                                            Remand in Custody
                                          </option>
                                          <option
                                            value="3"
                                          >
                                            Unconditional Bail
                                          </option>
                                        </select>
                                      </pdk-select>
                                    </cpp-fixed-list-input>
                                  </fieldset>
                                </pdk-form-group>
                              </pdk-form-field>
                            </cpp-fixl-prompt-choice>
                          </div>
                        </cpp-prompt-choice>
                        <pdk-button-group>
                          <div
                            class="govuk-button-group"
                          >
                            <button
                              class="govuk-button"
                              pdk-button=""
                              type="submit"
                            >
                              Save result details
                            </button>
                          </div>
                        </pdk-button-group>
                      </form>
                    </cpp-result-prompts-form>
                  </pdk-details-text>
                </details>
              </cpp-nhccs-result-line-body>
            </div>
          </cpp-draft-result-line-body>
        </cpp-resolved-draft-result-line>
      </div>
    </cpp-draft-result-line>
  </cpp-draft-result-line-container>
</ng-component>
`;

